{
    "id": "miruro",
    "name": "Miruro",
    "version": "1.0.4",
    "description": "AniList-quality metadata with playback aggregated from several upstream providers (AllAnime, AnimePahe, AniKoto, AnimeDao, ...) - if one provider is down, pick another as a separate group.",
    "author": "Hibiki",
    "website": "https://www.miruro.to",
    "iconUrl": "https://www.miruro.to/assets/logo-Dnw3w3dS.png",
    "lang": "en",
    "resolverDependencies": ["animepahe-player"],
    "capabilities": [
        "LATEST_RELEASES",
        "PLAYBACK"
    ],
    "supportedSorts": [
        "RELEVANCE",
        "RATING",
        "TITLE",
        "YEAR",
        "VOTES"
    ],
    "supportedFilters": [
        "TYPE",
        "STATUS",
        "INCLUDED_GENRES",
        "EXCLUDED_GENRES",
        "YEAR_RANGE"
    ],
    "fallbackSort": "RELEVANCE",
    "cleartextPlaybackHosts": []
}
