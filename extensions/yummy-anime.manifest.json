{
    "id": "yummy-anime",
    "name": "YummyAnime",
    "version": "1.1.1",
    "author": "Hibiki",
    "website": "https://ru.yummyani.me",
    "iconUrl": "https://yummyani.me/favicon.ico",
    "lang": "ru",
    "resolverDependencies": [
        "aniboom",
        "alloha",
        "sibnet",
        "aksor",
        "cvh",
        "kodik",
        "vk"
    ],
    "capabilities": [
        "LATEST_RELEASES",
        "PLAYBACK",
        "RELATED_TITLES",
        "SIMILAR_TITLES",
        "ACCOUNT",
        "COMMENTS",
        "REVIEWS",
        "LIBRARY_SYNC"
    ],
    "supportedSorts": [
        "RELEVANCE",
        "RATING",
        "TITLE",
        "YEAR",
        "VOTES",
        "VIEWS",
        "COMMENTS"
    ],
    "supportedFilters": [
        "TYPE",
        "STATUS",
        "INCLUDED_GENRES",
        "EXCLUDED_GENRES",
        "YEAR_RANGE"
    ],
    "fallbackSort": "RELEVANCE",
    "settings": [
        {
            "key": "account",
            "type": "ACCOUNT",
            "title": "YummyAnime account",
            "description": "Sign in to read and post comments and reviews, and to keep your lists in sync."
        },
        {
            "key": "syncLibrary",
            "type": "TOGGLE",
            "title": "Sync library to your account",
            "description": "Sends a title's status and score to YummyAnime when you change them here.",
            "default": true
        }
    ]
}
